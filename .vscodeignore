.vscode/**
.vscode-test/**
src/**
webview/src/**
webview/node_modules/**
test/**
# The component half of the suite. `test/**` above is anchored at the root and
# does not reach it — measured: both its .tsx files shipped in 0.36.0 before
# this line existed.
webview/test/**
docs/**
**/*.ts
# .tsx as well as .ts. `webview/src/**` already covers the components, so this
# is for everything else — and it is what the two leaked files needed.
**/*.tsx
**/*.map
esbuild.config.mjs
tsconfig.json
vitest.config.*
.gitignore
*.vsix
# The agent environment. Dev-only in every part: the rules and hooks are for
# whoever works on the extension, not for anyone running it.
.claude/**
CLAUDE.md
.claudeignore
skills-lock.json
scripts/**
.prettierrc.json
.prettierignore
.prettierrc
eslint.config.mjs
.stylelintrc.json
# Lockfiles are dev-only — they were leaking into the package
# (bun.lock and webview/package-lock.json both shipped before).
**/*.lock
**/package-lock.json
dist-vsix/**
.cache/**
**/*.tgz
node_modules/.bin/**
# A stray full copy of the ghost.one project lives in this repo on purpose
# (kept as a quality reference). Never pack it — vsce otherwise walks 3.8 GB.
ghost.one/**
# Dev-only manifests for the webview sub-project. `webview/dist/**` is the built
# UI and must stay; nothing reads these two at runtime. (The bare `tsconfig.json`
# rule above only anchors at the root — vsce does not match it at depth.)
webview/package.json
webview/tsconfig.json
# `assets/` is mostly README art: the banner and the screenshots are never read at
# runtime, only the two icons the manifest names. Excluding the rest cut the VSIX
# from 2.3 MB to well under a megabyte. Written as deny-then-allow so a re-shot
# screenshot is excluded by default and cannot silently start shipping again —
# adding a *new* runtime image means adding it here.
assets/**
!assets/luno-icon-500.png
!assets/luno-activitybar.png
# Screenshots taken at the repo root. The `assets/**` rule above does not reach
# them, and one shipped inside 0.21.0 — 130 kB of a debugging screenshot, in a
# package that is otherwise measured to the kilobyte. Every runtime image lives
# under `assets/`, so nothing at the root is ever needed.
*.png
*.jpg
# Dev-only, and at the root where the bare `tsconfig.json` rule does not reach.
tsconfig.test.json
TESTING.md

# Per-workspace LUNO state — chat attachments the user pasted. Gitignored
# too, but vsce reads this file, not .gitignore, so it shipped a 185 kB
# screenshot inside 0.22.2 before this line existed.
.luno/

# Scratch left in the repo root by probe agents reading the CLI binary. vsce
# reads this file rather than .gitignore, so the .gitignore entry does not
# cover it — it swept 14 files and 107 kB of probe output into 0.31.0 before
# this line.
.tmp-cli-probe/

# Everything under external/ that is not the recorders themselves. The built
# binaries in `external/audio/**` ship and are what the panel spawns; the crate
# that produced them and the throwaway probes beside it are dev-only, and
# `**/*.rs` would not catch Cargo.toml or the lockfile anyway.
external/native/**
external/scratch/**

# Page snapshots and screenshots the Playwright MCP writes into the repo root
# while the browser harness is being driven. Gitignored, but vsce reads this
# file and not .gitignore — 25 files and 635 kB of debugging screenshots went
# into the 1.2.0 build before this line, taking it from 1.28 MB to 1.77 MB.
# Neither `*.png` nor `assets/**` reaches them: both are anchored elsewhere,
# and half of what it writes is `.yml` anyway.
.playwright-mcp/

# CI workflows and issue templates. Dev-only, and nothing at runtime reads
# them — the same class as `scripts/**` above.
.github/**
